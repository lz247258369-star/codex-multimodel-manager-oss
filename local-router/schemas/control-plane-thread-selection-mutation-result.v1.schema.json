{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codex.multimodel.local-router/control-plane-thread-selection-mutation-result/v1",
  "title": "HS-1B thread selection mutation result",
  "description": "Applied per-thread selection state. A set returns a PENDING claim (never active, never a model switch by itself); a clear returns the cleared state.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "result", "thread_ref", "selection_state", "selection_model", "selection_generation", "expires_at"],
  "properties": {
    "schema_version": { "const": 1 },
    "result": { "const": "applied" },
    "thread_ref": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
    "selection_state": { "enum": ["cleared", "expired", "none", "pending", "active", "superseded", "unknown"] },
    "selection_model": { "type": ["string", "null"] },
    "selection_generation": { "type": "integer", "minimum": 0 },
    "expires_at": { "type": ["string", "null"] }
  }
}
