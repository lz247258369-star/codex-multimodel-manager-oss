{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codex.multimodel.local-router/control-plane-usage/v1",
  "title": "LR-14P bounded usage/cost projection",
  "description": "Bounded recent usage/cost projection over the production RequestMeteringStore. Unknown usage/cost stay null, never zero; costs are informational estimates, never billing truth.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scope", "billing_note", "record_count", "capacity", "known_usage_count", "unknown_usage_count", "known_cost_count", "unknown_cost_count", "input_tokens_total", "output_tokens_total", "estimated_cost_by_currency", "degraded", "degradation_codes", "records"],
  "properties": {
    "schema_version": { "const": 1 },
    "scope": { "const": "bounded_recent_records" },
    "billing_note": { "const": "informational_estimate_not_billing" },
    "record_count": { "type": "integer", "minimum": 0 },
    "capacity": { "type": "integer", "minimum": 1 },
    "known_usage_count": { "type": "integer", "minimum": 0 },
    "unknown_usage_count": { "type": "integer", "minimum": 0 },
    "known_cost_count": { "type": "integer", "minimum": 0 },
    "unknown_cost_count": { "type": "integer", "minimum": 0 },
    "input_tokens_total": { "type": ["integer", "null"], "minimum": 0 },
    "output_tokens_total": { "type": ["integer", "null"], "minimum": 0 },
    "estimated_cost_by_currency": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["currency", "total_cost"],
        "properties": {
          "currency": { "type": "string" },
          "total_cost": { "type": "number" }
        }
      }
    },
    "degraded": { "type": "boolean" },
    "degradation_codes": { "type": "array", "items": { "type": "string" } },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["request_id", "trace_id", "metering_status", "stream", "completed_at", "duration_ms"],
        "properties": {
          "request_id": { "type": "string" },
          "trace_id": { "type": "string" },
          "client_id": { "type": ["string", "null"] },
          "config_generation": { "type": ["string", "null"] },
          "provider_id": { "type": ["string", "null"] },
          "route_id": { "type": ["string", "null"] },
          "model_route_id": { "type": ["string", "null"] },
          "model_id": { "type": ["string", "null"] },
          "upstream_model_id": { "type": ["string", "null"] },
          "usage": { "type": ["object", "null"] },
          "cost_estimate": { "type": ["object", "null"] },
          "metering_status": { "enum": ["recorded", "usage_missing", "identity_unavailable", "metering_degraded"] },
          "stream": { "type": "boolean" },
          "completed_at": { "type": "string" },
          "duration_ms": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
