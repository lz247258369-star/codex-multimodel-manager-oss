{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codex.multimodel.local-router/owner-record/v1",
  "title": "OwnerRecord v1",
  "description": "Schema-v1 router process ownership record. Contains no secrets or command-line values.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "pid", "process_fingerprint", "process_start_ticks", "host", "port", "created_at", "version"],
  "properties": {
    "schema_version": { "const": 1 },
    "pid": { "type": "integer", "minimum": 1 },
    "process_fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "process_start_ticks": { "type": "integer", "minimum": 0 },
    "host": { "const": "127.0.0.1" },
    "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "owner_user_sid_hash": { "type": ["string", "null"], "pattern": "^[0-9a-f]{0,64}$" },
    "config_generation": { "type": ["string", "null"], "pattern": "^[0-9a-f]{0,64}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "version": { "type": "integer", "minimum": 1 }
  }
}
