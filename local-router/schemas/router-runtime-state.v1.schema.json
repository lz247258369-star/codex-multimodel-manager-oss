{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codex.multimodel.local-router/router-runtime-state/v1",
  "title": "RouterRuntimeState v1",
  "description": "Schema-v1 Router runtime control-plane state. Contains no requests, content, or secret values.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "version", "lifecycle", "config_generation", "updated_at", "migration_receipts"],
  "properties": {
    "schema_version": { "const": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "lifecycle": { "enum": ["STOPPED", "STARTING", "READY", "DEGRADED", "STOPPING", "FAILED"] },
    "config_generation": { "type": "string", "pattern": "^[0-9a-f]{0,64}$" },
    "started_at": { "type": ["string", "null"], "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "last_failure": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["code", "message", "occurred_at"],
      "properties": {
        "code": { "type": "string", "minLength": 1, "maxLength": 128 },
        "message": { "type": "string", "minLength": 1, "maxLength": 512 },
        "occurred_at": { "type": "string", "format": "date-time" }
      }
    },
    "migration_receipts": {
      "type": "array",
      "items": { "$ref": "migration-receipt/v1" }
    }
  }
}
