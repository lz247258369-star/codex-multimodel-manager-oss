{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codex.multimodel.local-router/secret-reference/v1",
  "title": "SecretReference v1",
  "description": "Schema-v1 secret reference. Contains a reference name only; never a value.",
  "type": "object",
  "additionalProperties": false,
  "required": ["resolver", "name", "scope", "allowed_provider_ids", "version"],
  "properties": {
    "resolver": { "const": "environment" },
    "name": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,127}$" },
    "scope": { "enum": ["process", "user", "user_or_process"] },
    "allowed_provider_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
    },
    "version": { "type": "integer", "minimum": 1 }
  }
}
