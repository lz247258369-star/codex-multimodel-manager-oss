<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Router.Host</RootNamespace>
    <AssemblyName>Router.Host</AssemblyName>
    <IsPackable>false</IsPackable>
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>false</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Router.Core\Router.Core.csproj" />
    <ProjectReference Include="..\Router.CatalogProjection\Router.CatalogProjection.csproj" />
    <ProjectReference Include="..\Router.Configuration\Router.Configuration.csproj" />
    <ProjectReference Include="..\Router.Execution\Router.Execution.csproj" />
    <ProjectReference Include="..\Router.Ingress\Router.Ingress.csproj" />
    <ProjectReference Include="..\Router.Metering\Router.Metering.csproj" />
    <ProjectReference Include="..\Router.Observability\Router.Observability.csproj" />
    <ProjectReference Include="..\Router.Secrets\Router.Secrets.csproj" />
    <ProjectReference Include="..\Router.State\Router.State.csproj" />
    <ProjectReference Include="..\Router.ThreadSelection\Router.ThreadSelection.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\config\router.defaults.json">
      <Link>config\router.defaults.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\..\installer\model-catalog.json">
      <Link>model-catalog.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>
