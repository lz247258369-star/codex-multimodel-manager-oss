    <ProjectReference Include="..\..\src\Router.Routing\Router.Routing.csproj" />
    <ProjectReference Include="..\..\src\Router.Secrets\Router.Secrets.csproj" />
    <ProjectReference Include="..\..\src\Router.UpstreamHttp\Router.UpstreamHttp.csproj" />
    <ProjectReference Include="..\Router.FakeProvider\Router.FakeProvider.csproj" />
  </ItemGroup>
</Project>
