<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Router.Core.Tests</RootNamespace>
    <AssemblyName>Router.Core.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- CA1707 conflicts with the standard xUnit snake_case naming convention. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Router.Core\Router.Core.csproj" />
    <ProjectReference Include="..\..\src\Router.Host\Router.Host.csproj" />
    <ProjectReference Include="..\..\src\Router.Configuration\Router.Configuration.csproj" />
    <ProjectReference Include="..\..\src\Router.Secrets\Router.Secrets.csproj" />
    <ProjectReference Include="..\..\src\Router.State\Router.State.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\config\router.defaults.json">
      <Link>config\router.defaults.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\..\installer\model-catalog.json">
      <Link>model-catalog.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\..\tests\fixtures\local-router\v1\**">
      <Link>fixtures\local-router\v1\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
