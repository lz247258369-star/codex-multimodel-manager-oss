<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Router.Observability.Tests</RootNamespace>
    <AssemblyName>Router.Observability.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- CA1707 conflicts with the standard xUnit snake_case naming convention. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Router.Core\Router.Core.csproj" />
    <ProjectReference Include="..\..\src\Router.Health\Router.Health.csproj" />
    <ProjectReference Include="..\..\src\Router.Observability\Router.Observability.csproj" />
    <ProjectReference Include="..\..\src\Router.ProviderAdapters.Abstractions\Router.ProviderAdapters.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\Router.Registries\Router.Registries.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\..\tests\fixtures\local-router\v1\observability\**">
      <Link>fixtures\local-router\v1\observability\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
