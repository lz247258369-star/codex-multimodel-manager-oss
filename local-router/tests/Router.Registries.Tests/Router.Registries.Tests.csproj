<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Router.Registries.Tests</RootNamespace>
    <AssemblyName>Router.Registries.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- CA1707 conflicts with the standard xUnit snake_case naming convention. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Router.CatalogProjection\Router.CatalogProjection.csproj" />
    <ProjectReference Include="..\..\src\Router.Configuration\Router.Configuration.csproj" />
    <ProjectReference Include="..\..\src\Router.Core\Router.Core.csproj" />
    <ProjectReference Include="..\..\src\Router.Registries\Router.Registries.csproj" />
    <ProjectReference Include="..\..\src\Router.Secrets\Router.Secrets.csproj" />
    <ProjectReference Include="..\Router.TestSupport\Router.TestSupport.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\..\tests\fixtures\local-router\v1\catalog\**">
      <Link>fixtures\local-router\v1\catalog\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
